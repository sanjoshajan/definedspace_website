# Contact Form Email Dispatch Settings (SMTP)
# Options: Gmail SMTP, SendGrid, Resend, Amazon SES, or any standard SMTP service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=definedspacearchitecture@gmail.com
SMTP_PASS=your_app_password_here

# Recipient Email for Client Inquiries
CONTACT_RECIPIENT_EMAIL=definedspacearchitecture@gmail.com

# Base Site URL
NEXT_PUBLIC_SITE_URL=https://definedspacearchitecture.com
